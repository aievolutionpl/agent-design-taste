{
  "name": "03-liquid-glass",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#0B1120",
      "surface": "#141C2F",
      "text": "#FFFFFF",
      "text-secondary": "rgb(255 255 255 / 0.62)",
      "border": "rgb(255 255 255 / 0.12)",
      "primary": "#0A74E0",
      "primary-contrast": "#FFFFFF",
      "accent": "#0A74E0",
      "accent-contrast": "#FFFFFF",
      "success": "#30D158",
      "warning": "#FFD60A",
      "error": "#FF453A"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Figtree', 'Inter', sans-serif",
      "mono": "'Geist Mono', 'JetBrains Mono', monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "40px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "12px",
      "md": "24px",
      "lg": "32px",
      "pill": "999px"
    },
    "shadows": {
      "float": "var(--lg-shadow)",
      "focus": "0 0 0 4px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "200ms",
      "normal": "350ms",
      "slow": "500ms",
      "ambient": "90s"
    },
    "motionEase": {
      "default": "cubic-bezier(0.32, 0.72, 0, 1)"
    }
  },
  "dark": {}
}
