{
  "name": "13-y2k-retrofuturism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#E8F1F8",
      "surface": "#FFFFFF",
      "text": "#1B2A3A",
      "text-secondary": "#596F85",
      "border": "#B9CCDD",
      "primary": "#3B5BDB",
      "primary-contrast": "#FFFFFF",
      "accent-1": "#C77DFF",
      "accent-2": "#64E0D4",
      "accent-3": "#FFB8D1",
      "success": "#1FA97C",
      "warning": "#E0A010",
      "error": "#E04060"
    },
    "fonts": {
      "sans": "'Space Grotesk', system-ui, sans-serif",
      "display": "'Orbitron', 'Space Grotesk', sans-serif",
      "mono": "'Space Mono', monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "38px",
      "h3": "26px",
      "h4": "20px",
      "h5": "17px",
      "h6": "15px",
      "body": "16px",
      "small": "13px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "pill": "999px"
    },
    "shadows": {
      "panel": "0 8px 24px rgb(27 42 58 / 0.10)",
      "focus": "0 0 0 3px var(--color-primary)"
    },
    "container": {
      "width": "1200px"
    },
    "borders": {
      "default": "2px solid var(--color-border)",
      "strong": "3px solid var(--color-text)"
    },
    "motion": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "400ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.22, 1, 0.36, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0E1626",
      "surface": "#1A2A44",
      "text": "#E8F1F8",
      "text-secondary": "#8FA6C4",
      "border": "#34507A",
      "primary": "#7AA8FF",
      "primary-contrast": "#0E1626",
      "accent-1": "#D9A8FF",
      "accent-2": "#7CF0E4",
      "accent-3": "#FFC4DC"
    }
  }
}
