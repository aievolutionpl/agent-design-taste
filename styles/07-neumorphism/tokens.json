{
  "name": "07-neumorphism",
  "light": {
    "colors": {
      "-bg": "#ECF0F3",
      "-surface": "#ECF0F3",
      "-text": "#111827",
      "-text-secondary": "#4B5563",
      "-border": "#C8D0E0",
      "-primary": "#4F6AF0",
      "-primary-contrast": "#FFFFFF",
      "-accent": "#4F6AF0",
      "-accent-contrast": "#FFFFFF",
      "-success": "#16A34A",
      "-warning": "#D97706",
      "-error": "#DC2626"
    },
    "shadows": {
      "-dark": "#C8D0E0",
      "-light": "#FFFFFF",
      "-raised": "6px 6px 12px var(--shadow-dark), -6px -6px 12px var(--shadow-light)",
      "-raised-lg": "10px 10px 20px var(--shadow-dark), -10px -10px 20px var(--shadow-light)",
      "-inset": "inset 4px 4px 8px var(--shadow-dark), inset -4px -4px 8px var(--shadow-light)",
      "-focus": "0 0 0 3px var(--color-accent)"
    },
    "fonts": {
      "-sans": "'Nunito Sans', system-ui, sans-serif",
      "-display": "'Manrope', 'Nunito Sans', sans-serif"
    },
    "fontSizes": {
      "-h1": "48px",
      "-h2": "36px",
      "-h3": "24px",
      "-h4": "20px",
      "-h5": "17px",
      "-h6": "15px",
      "-body": "16px",
      "-small": "14px",
      "-label": "11px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "-sm": "12px",
      "-md": "18px",
      "-lg": "24px"
    },
    "containerWidth": "1100px",
    "motion": {
      "-fast": "150ms",
      "-normal": "200ms",
      "-slow": "400ms",
      "-ease": "cubic-bezier(0.22, 1, 0.36, 1)"
    }
  },
  "dark": {
    "colors": {
      "-bg": "#23272E",
      "-surface": "#23272E",
      "-text": "#E5E7EB",
      "-text-secondary": "#9CA3AF",
      "-border": "#3B424D"
    },
    "shadows": {
      "-dark": "#14161B",
      "-light": "#3B424D"
    }
  }
}