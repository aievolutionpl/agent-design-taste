{
  "name": "17-organic-natural",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F6F1E7",
      "surface": "#EDE5D4",
      "text": "#2A271F",
      "text-secondary": "#5C5647",
      "border": "#DACFBA",
      "primary": "#3D5638",
      "primary-contrast": "#FFFFFF",
      "accent": "#A44A26",
      "accent-contrast": "#FFFFFF",
      "success": "#3D5638",
      "warning": "#8C5A12",
      "error": "#A3271C",
      "paper-grain": "rgb(42 39 31 / 0.05)"
    },
    "fonts": {
      "sans": "'Figtree', system-ui, sans-serif",
      "display": "'Young Serif', Georgia, serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "fontSizes": {
      "h1": "68px",
      "h2": "44px",
      "h3": "26px",
      "h4": "21px",
      "h5": "18px",
      "h6": "16px",
      "body": "18px",
      "small": "15px",
      "label": "13px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "10px",
      "md": "18px",
      "lg": "28px",
      "pill": "999px",
      "organic": "58% 42% 47% 53% / 52% 46% 54% 48%"
    },
    "shadows": {
      "soft": "0 10px 30px -18px rgb(61 46 20 / 0.35)",
      "focus": "0 0 0 3px var(--color-primary)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1.5px solid var(--color-text)"
    },
    "container": {
      "width": "1180px"
    },
    "motion": {
      "fast": "180ms",
      "normal": "320ms",
      "slow": "600ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.33, 1, 0.68, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#1B1A15",
      "surface": "#25231C",
      "text": "#EFE8D7",
      "text-secondary": "#B5AD99",
      "border": "#3A372C",
      "primary": "#A9C49B",
      "primary-contrast": "#1B1A15",
      "accent": "#E39069",
      "accent-contrast": "#1B1A15",
      "paper-grain": "rgb(239 232 215 / 0.04)"
    },
    "shadows": {
      "soft": "0 10px 30px -18px rgb(0 0 0 / 0.6)"
    }
  }
}
