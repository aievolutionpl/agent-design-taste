{
  "name": "09-skeuomorphism-tactile",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#E8E9EB",
      "panel": "#F2F3F4",
      "well": "#D7D9DC",
      "text": "#1F2328",
      "text-secondary": "#5A6068",
      "primary": "#2F6FED",
      "primary-contrast": "#FFFFFF",
      "action-hw": "#F25C05",
      "readout": "#FFB000",
      "led-ok": "#3DDC84",
      "led-warn": "#FFB000",
      "led-err": "#FF4D4D",
      "success": "#2E9E5B",
      "warning": "#B87400",
      "error": "#C93A3A"
    },
    "fonts": {
      "sans": "'IBM Plex Sans', system-ui, sans-serif",
      "display": "'Space Grotesk', 'IBM Plex Sans', sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "fontSizes": {
      "h1": "48px",
      "h2": "34px",
      "h3": "24px",
      "h4": "19px",
      "body": "16px",
      "small": "13px",
      "label": "10px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "11": "44px",
      "14": "56px",
      "24": "96px"
    },
    "radius": {
      "xs": "4px",
      "sm": "6px",
      "md": "8px",
      "lg": "12px"
    },
    "shadows": {
      "raised": "0 2px 2px rgba(0, 0, 0, 0.12), 0 4px 10px rgba(0, 0, 0, 0.08),\n                   inset 0 1px 0 rgba(255, 255, 255, 0.7)",
      "press": "inset 0 2px 5px rgba(0, 0, 0, 0.28)",
      "well": "inset 0 2px 4px rgba(0, 0, 0, 0.25), inset 0 -1px 0 rgba(255, 255, 255, 0.5)",
      "btn": "0 2px 0 rgba(0, 0, 0, 0.35), 0 4px 10px rgba(0, 0, 0, 0.15),\n                inset 0 1px 0 rgba(255, 255, 255, 0.35)",
      "knob": "0 3px 8px rgba(0, 0, 0, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.55),\n                 inset 0 -2px 4px rgba(0, 0, 0, 0.25)",
      "focus": "0 0 0 3px rgba(47, 111, 237, 0.40)"
    },
    "container": {
      "width": "1160px"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "2px solid var(--color-text)"
    },
    "motion": {
      "fast": "150ms",
      "normal": "200ms",
      "clunk": "cubic-bezier(0.2, 0.9, 0.3, 1.2)"
    },
    "motionEase": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#14161A",
      "panel": "#1E2126",
      "well": "#0E1013",
      "text": "#E8EAED",
      "text-secondary": "#9AA0A6",
      "primary": "#4F87FF",
      "action-hw": "#FF6B14",
      "readout": "#FFC133"
    },
    "shadows": {
      "raised": "0 2px 2px rgba(0, 0, 0, 0.55), 0 4px 10px rgba(0, 0, 0, 0.35),\n                   inset 0 1px 0 rgba(255, 255, 255, 0.12)",
      "press": "inset 0 2px 5px rgba(0, 0, 0, 0.60)",
      "well": "inset 0 2px 4px rgba(0, 0, 0, 0.60), inset 0 -1px 0 rgba(255, 255, 255, 0.08)",
      "btn": "0 2px 0 rgba(0, 0, 0, 0.60), 0 4px 10px rgba(0, 0, 0, 0.40),\n                inset 0 1px 0 rgba(255, 255, 255, 0.18)",
      "knob": "0 3px 8px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.16),\n                 inset 0 -2px 4px rgba(0, 0, 0, 0.45)"
    }
  }
}
