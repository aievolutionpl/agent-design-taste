{
  "name": "04-bento-grid",
  "light": {
    "colors": {
      "-bg": "#F4F4F2",
      "-surface": "#FFFFFF",
      "-surface-strong": "#111111",
      "-text": "#111111",
      "-text-secondary": "#5C5C58",
      "-border": "#E2E2DE",
      "-primary": "#111111",
      "-primary-contrast": "#FFFFFF",
      "-accent": "#0D9488",
      "-accent-contrast": "#FFFFFF",
      "-success": "#16A34A",
      "-warning": "#D97706",
      "-error": "#DC2626"
    },
    "fonts": {
      "-sans": "'Inter', system-ui, sans-serif",
      "-display": "'Space Grotesk', 'Inter', sans-serif",
      "-mono": "'IBM Plex Mono', monospace"
    },
    "fontSizes": {
      "-h1": "52px",
      "-h2": "36px",
      "-h3": "24px",
      "-h4": "20px",
      "-h5": "17px",
      "-body": "16px",
      "-tile-body": "15px",
      "-small": "13px",
      "-label": "11px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "-sm": "8px",
      "-md": "12px",
      "-lg": "16px"
    },
    "shadows": {
      "-tile-hover": "0 2px 0 0 var(--color-border)",
      "-focus": "0 0 0 3px rgb(13 148 136 / 0.35)"
    },
    "borders": {
      "-default": "1px solid var(--color-border)",
      "-strong": "2px solid var(--color-text)"
    },
    "containerWidth": "1240px",
    "motion": {
      "-fast": "180ms",
      "-normal": "250ms",
      "-slow": "400ms",
      "-ease": "cubic-bezier(0.16, 1, 0.3, 1)",
      "-stagger": "40ms"
    }
  },
  "dark": {
    "colors": {
      "-bg": "#0C0C0B",
      "-surface": "#161615",
      "-surface-strong": "#F4F4F2",
      "-text": "#F4F4F2",
      "-text-secondary": "#A1A19B",
      "-border": "#262624",
      "-primary": "#F4F4F2",
      "-primary-contrast": "#0C0C0B",
      "-accent": "#2DD4BF"
    }
  }
}