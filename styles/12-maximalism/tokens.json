{
  "name": "12-maximalism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FDF6EC",
      "surface": "#FFFFFF",
      "surface-tint": "#FFE8CC",
      "text": "#1A0B2E",
      "text-secondary": "#5C4A72",
      "border": "#1A0B2E",
      "primary": "#CF3A26",
      "primary-contrast": "#FDF6EC",
      "accent-1": "#FFB000",
      "accent-2": "#7B2FA0",
      "accent-3": "#0FA3A3",
      "success": "#1B8A3A",
      "warning": "#E07B00",
      "error": "#C22626"
    },
    "fonts": {
      "sans": "'Archivo', system-ui, sans-serif",
      "display": "'Fraunces', 'Playfair Display', serif",
      "mono": "'Space Mono', monospace"
    },
    "fontSizes": {
      "h1": "72px",
      "h2": "44px",
      "h3": "30px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "none": "0px",
      "pill": "999px",
      "blob": "58% 42% 55% 45% / 45% 55% 45% 55%"
    },
    "borders": {
      "thick": "2px solid var(--color-border)"
    },
    "shadows": {
      "hard": "4px 4px 0 var(--color-border)",
      "hard-lg": "8px 8px 0 var(--color-border)",
      "focus": "0 0 0 3px var(--color-primary)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "450ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#1A0B2E",
      "surface": "#2A1745",
      "surface-tint": "#3A2158",
      "text": "#FDF6EC",
      "text-secondary": "#B9A8D4",
      "border": "#FDF6EC",
      "primary": "#FFB000",
      "primary-contrast": "#1A0B2E"
    }
  }
}
