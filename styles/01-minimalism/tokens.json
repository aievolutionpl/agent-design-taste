{
  "name": "01-minimalism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FFFFFF",
      "surface": "#F7F7F5",
      "text": "#111111",
      "text-secondary": "#555555",
      "border": "#E5E5E2",
      "primary": "#111111",
      "primary-contrast": "#FFFFFF",
      "accent": "#2563EB",
      "accent-contrast": "#FFFFFF",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Archivo', 'Inter', sans-serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "40px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "6px",
      "md": "8px",
      "lg": "12px"
    },
    "shadows": {
      "none": "none",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0A0A0A",
      "surface": "#161616",
      "text": "#F5F5F4",
      "text-secondary": "#A3A3A3",
      "border": "#262626",
      "primary": "#F5F5F4",
      "primary-contrast": "#0A0A0A"
    }
  }
}
