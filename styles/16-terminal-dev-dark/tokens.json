{
  "name": "16-terminal-dev-dark",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F6F6F3",
      "surface": "#ECECE7",
      "text": "#0C0E0F",
      "text-secondary": "#50575E",
      "border": "#D3D5D0",
      "primary": "#0C0E0F",
      "primary-contrast": "#F6F6F3",
      "accent": "#0B6B33",
      "accent-contrast": "#FFFFFF",
      "success": "#0B6B33",
      "warning": "#8A5A00",
      "error": "#B42318",
      "code-bg": "#ECECE7",
      "diff-add": "rgb(11 107 51 / 0.12)",
      "diff-del": "rgb(180 35 24 / 0.10)"
    },
    "fonts": {
      "sans": "'IBM Plex Sans', system-ui, sans-serif",
      "display": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace",
      "mono": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "36px",
      "h3": "22px",
      "h4": "18px",
      "h5": "16px",
      "h6": "14px",
      "body": "16px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px"
    },
    "shadows": {
      "none": "none",
      "window": "0 0 0 1px var(--color-border)",
      "focus": "0 0 0 2px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text-secondary)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "80ms",
      "normal": "160ms",
      "slow": "240ms",
      "caret": "1060ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0B0D0E",
      "surface": "#131618",
      "text": "#E7E9E6",
      "text-secondary": "#949CA3",
      "border": "#262B2F",
      "primary": "#E7E9E6",
      "primary-contrast": "#0B0D0E",
      "accent": "#5BE08F",
      "accent-contrast": "#04140A",
      "success": "#5BE08F",
      "warning": "#F2B84B",
      "error": "#FF7A70",
      "code-bg": "#0F1213",
      "diff-add": "rgb(91 224 143 / 0.10)",
      "diff-del": "rgb(255 122 112 / 0.10)"
    }
  }
}
