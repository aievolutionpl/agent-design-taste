{
  "name": "11-editorial-magazine",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FDFBF7",
      "surface": "#F4EFE6",
      "text": "#1A1815",
      "text-secondary": "#6B6259",
      "border": "#E3DCD0",
      "primary": "#1A1815",
      "primary-contrast": "#FDFBF7",
      "accent": "#8C2F1B",
      "accent-contrast": "#FDFBF7",
      "success": "#3E6B3A",
      "warning": "#A86B1C",
      "error": "#8C2F1B"
    },
    "fonts": {
      "serif-body": "'Source Serif 4', Georgia, serif",
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Fraunces', Georgia, serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "40px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "18px",
      "small": "14px",
      "caption": "13px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "2px",
      "md": "2px",
      "lg": "4px"
    },
    "shadows": {
      "none": "none",
      "paper": "0 8px 24px rgb(26 24 21 / 0.08)",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.22, 1, 0.36, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#14110E",
      "surface": "#1F1B16",
      "text": "#F2ECE2",
      "text-secondary": "#A69C8E",
      "border": "#35302A",
      "primary": "#F2ECE2",
      "primary-contrast": "#14110E"
    },
    "shadows": {
      "focus": "0 0 0 3px var(--color-text)"
    }
  }
}
