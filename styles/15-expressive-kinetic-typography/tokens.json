{
  "name": "15-expressive-kinetic-typography",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FAF7F2",
      "surface": "#FFFFFF",
      "text": "#14120E",
      "text-secondary": "#6B675F",
      "border": "#E8E3DA",
      "primary": "#14120E",
      "primary-contrast": "#FAF7F2",
      "accent": "#E4572E",
      "accent-contrast": "#FAF7F2",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Fraunces', 'Inter', serif",
      "mono": "'Space Mono', monospace"
    },
    "fontSizes": {
      "h1": "clamp(48px, 9vw, 96px)",
      "h2": "42px",
      "h3": "26px",
      "h4": "21px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "12px",
      "marquee": "clamp(24px, 4vw, 40px)"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "0px",
      "md": "0px",
      "lg": "0px"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text)"
    },
    "container": {
      "width": "1200px"
    },
    "shadows": {
      "none": "none",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "motion": {
      "hover": "250ms",
      "reveal": "0ms",
      "marquee": "999999s",
      "stagger": "60ms",
      "board": "steps(8, end)"
    },
    "motionEase": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0D0C0A",
      "surface": "#171512",
      "text": "#F5F1E8",
      "text-secondary": "#9B968B",
      "border": "#262320",
      "primary": "#F5F1E8",
      "primary-contrast": "#0D0C0A",
      "accent": "#FF6B3D",
      "accent-contrast": "#0D0C0A"
    }
  }
}
