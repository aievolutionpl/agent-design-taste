{
  "name": "14-3d-spatial-ui",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F4F4F0",
      "surface": "#FFFFFF",
      "text": "#101014",
      "text-secondary": "#5A5A5E",
      "border": "#E3E3DE",
      "primary": "#101014",
      "primary-contrast": "#FFFFFF",
      "accent": "#4F46E5",
      "accent-contrast": "#FFFFFF",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626",
      "glow": "rgb(79 70 229 / 0.12)"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Space Grotesk', 'Inter', sans-serif",
      "mono": "'Space Mono', 'IBM Plex Mono', monospace"
    },
    "fontSizes": {
      "h1": "60px",
      "h2": "42px",
      "h3": "26px",
      "h4": "21px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "11px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px"
    },
    "shadows": {
      "plane": "0 24px 60px -24px rgb(16 16 20 / 0.25)",
      "lift": "0 32px 72px -28px rgb(16 16 20 / 0.35)",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "200ms",
      "normal": "350ms",
      "slow": "500ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#060608",
      "surface": "#101014",
      "text": "#F2F2F0",
      "text-secondary": "#8E8E94",
      "border": "#1F1F26",
      "primary": "#F2F2F0",
      "primary-contrast": "#060608",
      "accent": "#8B8BF5",
      "accent-contrast": "#060608",
      "glow": "rgb(139 139 245 / 0.14)"
    },
    "shadows": {
      "plane": "0 24px 60px -20px rgb(0 0 0 / 0.7)",
      "lift": "0 32px 80px -24px rgb(0 0 0 / 0.85)"
    }
  }
}
