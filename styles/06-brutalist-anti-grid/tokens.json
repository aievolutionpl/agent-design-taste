{
  "name": "06-brutalist-anti-grid",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F4F1EA",
      "surface": "#FFFFFF",
      "text": "#111111",
      "text-secondary": "#444444",
      "border": "#111111",
      "primary": "#111111",
      "primary-contrast": "#FFFFFF",
      "accent": "#CCFF00",
      "accent-contrast": "#111111",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626"
    },
    "fonts": {
      "sans": "'Space Grotesk', 'Inter', system-ui, sans-serif",
      "display": "'Archivo Black', 'Space Grotesk', sans-serif",
      "mono": "'Space Mono', monospace"
    },
    "fontSizes": {
      "h1": "72px",
      "h2": "48px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "16px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "0",
      "md": "0",
      "lg": "0"
    },
    "borders": {
      "default": "2px solid var(--color-border)",
      "heavy": "3px solid var(--color-border)"
    },
    "shadows": {
      "hard": "8px 8px 0 var(--color-text)",
      "hard-sm": "4px 4px 0 var(--color-text)",
      "hard-accent": "8px 8px 0 var(--color-accent)",
      "focus": "0 0 0 3px var(--color-text)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "400ms"
    },
    "motionEase": {
      "default": "linear"
    }
  },
  "dark": {
    "colors": {
      "bg": "#141414",
      "surface": "#1E1E1E",
      "text": "#F2F2F2",
      "text-secondary": "#B3B3B3",
      "border": "#F2F2F2",
      "primary": "#F2F2F2",
      "primary-contrast": "#141414"
    },
    "shadows": {
      "hard": "8px 8px 0 #000000",
      "hard-sm": "4px 4px 0 #000000"
    }
  }
}
