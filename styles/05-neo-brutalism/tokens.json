{
  "name": "05-neo-brutalism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FFFDF5",
      "surface": "#FFFFFF",
      "surface-yellow": "#FFD02F",
      "surface-pink": "#FF90E8",
      "surface-blue": "#4D7CFE",
      "surface-green": "#23C55E",
      "surface-orange": "#FF6B35",
      "text": "#111111",
      "text-secondary": "#3D3D3A",
      "border": "#111111",
      "primary": "#FFD02F",
      "primary-contrast": "#111111",
      "accent": "#FF90E8",
      "accent-contrast": "#111111",
      "success": "#23C55E",
      "warning": "#FF6B35",
      "error": "#E11D48"
    },
    "fonts": {
      "sans": "'Space Grotesk', system-ui, sans-serif",
      "display": "'Archivo Black', 'Space Grotesk', sans-serif",
      "mono": "'Space Mono', monospace"
    },
    "fontSizes": {
      "h1": "64px",
      "h2": "44px",
      "h3": "26px",
      "h4": "20px",
      "body": "16px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "none": "0px",
      "sm": "2px",
      "md": "4px"
    },
    "shadows": {
      "offset-sm": "3px 3px 0 var(--color-border)",
      "offset-md": "6px 6px 0 var(--color-border)",
      "offset-lg": "10px 10px 0 var(--color-border)",
      "focus": "4px 4px 0 var(--color-accent)"
    },
    "borders": {
      "default": "2px solid var(--color-border)",
      "thick": "3px solid var(--color-border)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "press": "translate(3px, 3px)"
    },
    "motionEase": {
      "default": "steps(4, end)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#111111",
      "surface": "#1E1E1E",
      "text": "#FFFDF5",
      "text-secondary": "#B8B8B0",
      "border": "#FFFDF5",
      "primary": "#E6B800",
      "accent": "#E879C7",
      "surface-blue": "#3D6BE0"
    }
  }
}
