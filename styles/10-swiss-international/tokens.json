{
  "name": "10-swiss-international",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#FFFFFF",
      "surface": "#F4F4F2",
      "text": "#111111",
      "text-secondary": "#5C5C5C",
      "border": "#D9D9D6",
      "primary": "#111111",
      "primary-contrast": "#FFFFFF",
      "accent": "#E2231A",
      "accent-contrast": "#FFFFFF",
      "success": "#1A7A3C",
      "warning": "#C77800",
      "error": "#E2231A"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Inter Tight', 'Helvetica Neue', Arial, sans-serif",
      "mono": "'IBM Plex Mono', monospace"
    },
    "fontSizes": {
      "h1": "64px",
      "h2": "40px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "16px",
      "small": "13px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "0px",
      "md": "2px",
      "lg": "2px"
    },
    "shadows": {
      "none": "none",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "strong": "1px solid var(--color-text)"
    },
    "container": {
      "width": "1280px"
    },
    "motion": {
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0C0C0C",
      "surface": "#171717",
      "text": "#F2F2F0",
      "text-secondary": "#9C9C98",
      "border": "#2A2A2A",
      "primary": "#F2F2F0",
      "primary-contrast": "#0C0C0C"
    }
  }
}
