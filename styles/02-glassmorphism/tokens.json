{
  "name": "02-glassmorphism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F4F4FB",
      "surface": "#FFFFFF",
      "text": "#111111",
      "text-secondary": "#555555",
      "border": "#E4E4EF",
      "primary": "#111111",
      "primary-contrast": "#FFFFFF",
      "accent": "#7C3AED",
      "accent-contrast": "#FFFFFF",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626"
    },
    "fonts": {
      "sans": "'Inter', system-ui, sans-serif",
      "display": "'Plus Jakarta Sans', 'Inter', sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "fontSizes": {
      "h1": "56px",
      "h2": "40px",
      "h3": "28px",
      "h4": "22px",
      "h5": "18px",
      "h6": "16px",
      "body": "17px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px"
    },
    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px"
    },
    "shadows": {
      "card": "0 8px 32px rgb(0 0 0 / 0.12)",
      "focus": "0 0 0 3px var(--color-accent)"
    },
    "borders": {
      "default": "1px solid var(--color-border)",
      "glass": "1px solid var(--glass-border)"
    },
    "container": {
      "width": "1200px"
    },
    "motion": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "400ms",
      "ambient": "60s"
    },
    "motionEase": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#0F172A",
      "surface": "#1E293B",
      "text": "#F8FAFC",
      "text-secondary": "#94A3B8",
      "border": "rgb(255 255 255 / 0.10)",
      "primary": "#F8FAFC",
      "primary-contrast": "#0F172A",
      "accent": "#A78BFA",
      "accent-contrast": "#111111"
    }
  }
}
