{
  "name": "08-claymorphism",
  "source": "tokens.css",
  "light": {
    "colors": {
      "bg": "#F5F1FA",
      "surface": "#FFFFFF",
      "surface-tint": "#FBF9FE",
      "text": "#2D2438",
      "text-secondary": "#6B5E7F",
      "border": "rgba(45, 36, 56, 0.08)",
      "primary": "#7052E8",
      "primary-soft": "#E6DEFF",
      "primary-contrast": "#FFFFFF",
      "accent": "#FF8FA3",
      "accent-soft": "#FFE3E9",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "error": "#F87171"
    },
    "fonts": {
      "sans": "'Nunito Sans', system-ui, sans-serif",
      "display": "'Baloo 2', 'Nunito Sans', sans-serif"
    },
    "fontSizes": {
      "h1": "52px",
      "h2": "36px",
      "h3": "26px",
      "h4": "20px",
      "body": "16px",
      "small": "14px",
      "label": "12px"
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    },
    "radius": {
      "sm": "16px",
      "md": "24px",
      "lg": "32px",
      "pill": "999px"
    },
    "shadows": {
      "clay": "8px 8px 24px rgba(124, 92, 252, 0.18), -8px -8px 24px #FFFFFF,\n                 inset 0 2px 0 rgba(255, 255, 255, 0.7)",
      "clay-sm": "4px 4px 12px rgba(124, 92, 252, 0.16), -4px -4px 12px #FFFFFF,\n                    inset 0 1px 0 rgba(255, 255, 255, 0.7)",
      "btn": "inset 0 -4px 0 rgba(0, 0, 0, 0.18), 0 12px 24px rgba(124, 92, 252, 0.30)",
      "btn-press": "inset 0 -1px 0 rgba(0, 0, 0, 0.18), 0 4px 8px rgba(124, 92, 252, 0.25)",
      "inset": "inset 0 2px 6px rgba(45, 36, 56, 0.12)",
      "focus": "0 0 0 4px var(--color-primary)"
    },
    "container": {
      "width": "1140px"
    },
    "borders": {
      "default": "2px solid var(--color-border)",
      "strong": "3px solid var(--color-text)"
    },
    "motion": {
      "fast": "200ms",
      "normal": "300ms",
      "slow": "450ms"
    },
    "motionEase": {
      "default": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "dark": {
    "colors": {
      "bg": "#1E1830",
      "surface": "#2A2142",
      "surface-tint": "#322850",
      "text": "#F3EFFA",
      "text-secondary": "#B8A9D9",
      "border": "rgba(243, 239, 250, 0.10)",
      "primary": "#9B7DFF",
      "primary-soft": "#3D2E68",
      "accent": "#FFA6B5",
      "accent-soft": "#4A2E3C",
      "primary-contrast": "#111111"
    },
    "shadows": {
      "clay": "8px 8px 24px rgba(0, 0, 0, 0.45), -8px -8px 24px rgba(155, 125, 255, 0.07),\n                 inset 0 2px 0 rgba(255, 255, 255, 0.06)",
      "clay-sm": "4px 4px 12px rgba(0, 0, 0, 0.40), -4px -4px 12px rgba(155, 125, 255, 0.06),\n                    inset 0 1px 0 rgba(255, 255, 255, 0.06)",
      "btn": "inset 0 -4px 0 rgba(0, 0, 0, 0.35), 0 12px 24px rgba(0, 0, 0, 0.45)",
      "btn-press": "inset 0 -1px 0 rgba(0, 0, 0, 0.35), 0 4px 8px rgba(0, 0, 0, 0.40)",
      "inset": "inset 0 2px 6px rgba(0, 0, 0, 0.35)"
    }
  }
}
